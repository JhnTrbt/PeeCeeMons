{
  "$comment": "ComfyUI API-format graph. generate.py fills the {placeholders} and sets the numeric fields (seed, steps, cfg, sampler, size) by node id, so the JSON here always stays valid JSON. If `lora` is null in pipeline.config.json, node 8 is deleted and nodes 2/3/5 are rewired straight to the checkpoint. Swap this file for an export of your own workflow (Save (API Format) in ComfyUI) as long as the node ids below keep their roles.",

  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "{checkpoint}" }
  },
  "8": {
    "class_type": "LoraLoader",
    "inputs": {
      "lora_name": "{lora}",
      "strength_model": 0.85,
      "strength_clip": 0.85,
      "model": ["1", 0],
      "clip": ["1", 1]
    }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{positive}", "clip": ["8", 1] }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{negative}", "clip": ["8", 1] }
  },
  "4": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 512, "height": 512, "batch_size": 1 }
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 30,
      "cfg": 7.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": ["8", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["4", 0]
    }
  },
  "6": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["5", 0], "vae": ["1", 2] }
  },
  "7": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "peeceemons/{name}", "images": ["6", 0] }
  }
}
