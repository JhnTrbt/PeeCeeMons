{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Peeceemons",
  "version": "0.1.0",
  "identifier": "com.peeceemons.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    },
    "windows": [
      {
        "label": "overlay",
        "title": "Peeceemons overlay",
        "url": "overlay.html",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": false,
        "shadow": false,
        "visible": false,
        "width": 1280,
        "height": 160
      },
      {
        "label": "widget",
        "title": "Peeceemons",
        "url": "widget.html",
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "skipTaskbar": false,
        "shadow": false,
        "visible": true,
        "width": 420,
        "height": 600,
        "x": 40,
        "y": 40
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
